//C++
#include <bits/stdc++.h>
using namespace std;

int main()
{
	string n;
	while(cin>>n)
	{
		int sum=0,k=0,max=1,N;
		for(int i=0;i<n.length();i++)
		{
			if(n[i]>='0'&&n[i]<='9')
			{
				k=n[i]-'0';
			}
			else if(n[i]>='A'&&n[i]<='Z')
			{
				k=n[i]-'A'+10;
			}
			else if(n[i]>='a'&&n[i]<='z')
			{
				k=n[i]-'a'+36;
			}
			sum+=k;
			if(k>max)
			{
				max=k;
			}
		}
		for(N=max+1;N<=62;N++)
		{
			if(sum%(N-1)==0)
			{
				break;
			}
		}
		if(N<=62)
		{
			cout<<N<<endl;
		}
		else
		{
			 cout<<"such number is impossible!"<<endl;
		}
	}
	return 0;	
} 
